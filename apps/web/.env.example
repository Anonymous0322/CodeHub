# Copy this file to .env.local and replace the placeholders with your project values.
NEXT_PUBLIC_SITE_URL=https://codehub-uz.vercel.app

# Use the Supabase project URL and its publishable/anon key.
# Never put a secret/service_role key in a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key

# Server-only account-deletion cron. Keep these out of NEXT_PUBLIC_ variables.
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
CRON_SECRET=replace-with-a-long-random-secret

# Server-only 32-byte AES key (64 hex characters) used to encrypt saved AI provider keys.
AI_SETTINGS_ENCRYPTION_KEY=replace-with-64-hexadecimal-characters